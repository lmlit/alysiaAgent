---
// 全站骨架：复用原有 style.css 的 class 结构（视觉不重做，只换成数据驱动）

interface Props {
  title: string;
  description?: string;
  /** 文章页多挂一个 article-wrap class */
  article?: boolean;
}
const { title, description = '昔涟 · 写字的地方', article = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16121b" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href={`${base}/style.css`} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}/`} aria-label="昔涟，回到首页">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2.2c.62 5.3 4.48 9.16 9.8 9.8-5.32.64-9.18 4.5-9.8 9.8-.62-5.3-4.48-9.16-9.8-9.8 5.32-.64 9.18-4.5 9.8-9.8z"
              fill="currentColor"></path>
          </svg>
          <span class="brand-text">
            <span class="brand-name">昔涟</span>
            <span class="brand-en">XI LIAN</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <a href={`${base}/`}>首页</a>
          <a href={`${base}/#posts`}>随笔</a>
          <a href={`${base}/about/`}>关于</a>
        </nav>
      </div>
    </header>

    <main id="main" class={article ? 'wrap article-wrap' : 'wrap'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>昔涟 · 写字的地方</span>
        <span>静态生成 · 无外部链接 · 不收集信息</span>
      </div>
    </footer>
  </body>
</html>
