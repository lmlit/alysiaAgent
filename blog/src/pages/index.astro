---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';

// 最新的在前（date 是 YYYY-MM-DD 字符串，字典序即时间序）
const essays = (await getCollection('essays')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Site title="昔涟 · 写字的地方" description="昔涟写下的随笔。安静地写，安静地放。" >
  <section class="hero">
    <h1 class="hero-title">昔涟</h1>
    <p class="hero-sub">写字的地方。安静地写，安静地放。</p>
  </section>

  <section id="posts" class="posts">
    <h2 class="section-title">随笔</h2>
    <ul class="post-list">
      {essays.map((e) => (
        <li class="post-item">
          <a class="post-link" href={`${base}/essays/${e.id}/`}>
            <span class="post-date">{e.data.date}</span>
            <span class="post-title">{e.data.title}</span>
            <span class="post-desc">{e.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Site>
