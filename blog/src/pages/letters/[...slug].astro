---
// ★ 2026-10-21（add-letters）：信的单篇
import { getCollection, render } from "astro:content";
import { isLetter } from "@utils/content-utils";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

export async function getStaticPaths() {
  const all = await getCollection("posts");
  return all
    .filter((e) => isLetter(e))
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmt = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<MainGridLayout title={`信 · ${entry.data.title}`} description={entry.data.description}>
  <article class="card-base px-6 md:px-10 py-7 md:py-10 rounded-[var(--radius-large)] mb-4">
    <nav class="text-sm text-50 mb-6">
      <a href={`${basePath}/letters/`} class="hover:text-[var(--primary)] transition">信</a>
    </nav>

    <time class="text-sm text-50 tabular-nums" datetime={entry.data.published.toISOString()}>
      {fmt(entry.data.published)}
    </time>

    <div class="markdown-body mt-5 text-[15px] leading-[2]">
      <Content />
    </div>

    <p class="mt-10 pt-5 border-t border-dashed border-[var(--line-divider)] text-xs text-50">
      写完就放这儿了，没有改过。
    </p>
  </article>
</MainGridLayout>
