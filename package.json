{
  "name": "alysia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @alysia/server dev",
    "dev:console": "pnpm --filter @alysia/console dev",
    "build:console": "pnpm --filter @alysia/console build",
    "smoke": "node scripts/smoke-local.mjs",
    "chat": "node scripts/chat-local.mjs",
    "dev:diary": "node scripts/dev-private-diary.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@9.15.0"
}
