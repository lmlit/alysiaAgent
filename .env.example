# OpenAI-compatible API configuration
# Copy this file to .env and fill in your values

# ── LLM (Chat) API ──────────────────────────────
# Base URL — change this to switch providers:
#   OpenAI:     https://api.openai.com/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Moonshot:   https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=your-api-key-here

# Chat model (OpenAI-compatible /v1/chat/completions endpoint)
#   OpenAI: gpt-4o-mini
#   DeepSeek: deepseek-v4-flash, deepseek-chat
CHAT_MODEL=deepseek-v4-flash

# ── Embedding API ────────────────────────────────
# NOTE: DeepSeek does NOT support embeddings. Use OpenAI, Zhipu, or another provider.
#   OpenAI:  https://api.openai.com/v1
#   Zhipu:   https://open.bigmodel.cn/api/paas/v4
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_API_KEY=your-embed-api-key-here

# Embedding model
#   OpenAI:  text-embedding-3-small (1536 dims)
#   Zhipu:   embedding-2 (1024 dims)
EMBED_MODEL=embedding-2
EMBED_DIMENSION=1024

# ── QQ Official Bot ──────────────────────────────
# Get from QQ Open Platform https://q.qq.com
QQ_APP_ID=your-qq-app-id
QQ_APP_SECRET=your-qq-app-secret
