# 敏感文件——绝不能进构建上下文/镜像
.env
.env.*
!.env.example
*.pem
*.key

# 依赖与构建产物（镜像内重新安装/构建）
node_modules
packages/*/node_modules
packages/*/dist
*.tsbuildinfo

# 运行时数据（数据库/日志/工作区——挂载卷提供）
data
packages/*/data

# 版本控制与杂项
.git
.gitignore
alysia-image.tar
*.tar
docs
tests
tmp-*.ts
Dockerfile
compose.yml

# ★ 2026-10-27：构建上下文曾膨胀到数 GB（.video-demo 760MB / blog 537MB /
#   .probe 475MB / .tmp 382MB / packages 905MB），docker compose build 卡在
#   “Building” 7 小时无进展。镜像真正需要的只有：根 package/lock/workspace、
#   core+server 的 src/package/tsconfig、console/out。
.video-demo
.probe
.tmp
.tools
blog
cyrene-assets
packages/halo-theme-xilian
packages/dsh-adapter
packages/dsh-console
packages/console/.next
packages/console/app
packages/console/public
packages/console/scripts
packages/*/tests
packages/*/scripts
